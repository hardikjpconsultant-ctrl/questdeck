rules_version = '2';
// QuestDeck Firestore rules.
// 1. Replace admin@questdeck.local below if you changed admin.firebaseEmail in config.js.
// 2. Firebase console → Firestore → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "admin@questdeck.local";
    }

    // Courses and their chapters: anyone can read, only the admin can change.
    match /courses/{cid} {
      allow read: if true;
      allow write: if isAdmin();
      match /modules/{mid} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Learner accounts. The id is a SHA-256 of the email, so ids can't be enumerated
    // except by the admin. Sign-in is checked in the browser (PBKDF2), see README → Security.
    match /learners/{key} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if key.size() == 40
        && request.resource.data.keys().hasAll(['email', 'salt', 'hash', 'progress'])
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64;
      allow update: if request.resource.data.email == resource.data.email
        && (request.resource.data.hash == resource.data.hash
            || request.resource.data.resets == resource.data.get('resets', 0) + 1);
    }

    // Public leaderboard rows: one per learner per course.
    match /boards/{cid}/scores/{key} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if key.size() == 40
        && request.resource.data.email is string
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.total < 1000000
        && request.resource.data.weeks is map;
    }
  }
}
